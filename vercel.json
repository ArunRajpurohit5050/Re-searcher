{
  "builds": [
    { 
      "src": "api/main.py", 
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "dash.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "auth.js", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main.py" }
  ]
}